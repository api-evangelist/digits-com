{
  "opencollection": "1.0.0",
  "info": {
    "name": "Digits Connect Chart of Accounts Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://connect.digits.com/v1/oauth/authorize",
      "accessTokenUrl": "https://connect.digits.com/v1/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Webhook event delivery (partner-hosted)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://connect.digits.com/v1/webhooks/events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Digits POSTs a JSON event body to the partner-configured webhook endpoint. Documented here for reference; the partner hosts this endpoint and acknowledges with a 2xx response."
        }
      ]
    }
  ],
  "bundled": true
}