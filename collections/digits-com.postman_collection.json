{
  "info": {
    "name": "Digits Connect API",
    "description": "Digits Connect API - programmatic access to the Autonomous General Ledger (AGL). OAuth 2.0 auth-code flow; base URL https://connect.digits.com/v1. Endpoints derived from the developer.digits.com reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "accessToken", "value": "{{accessToken}}", "type": "string" },
      { "key": "tokenType", "value": "Bearer", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://connect.digits.com/v1" },
    { "key": "transactionId", "value": "" },
    { "key": "partyId", "value": "" }
  ],
  "item": [
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List ledger transaction entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/transactions/entries",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "transactions", "entries"]
            },
            "description": "Returns AI-categorized ledger entries. Cursor-paginated."
          }
        },
        {
          "name": "Query ledger transaction entries",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_date\": \"2026-01-01\",\n  \"end_date\": \"2026-06-30\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ledger/transactions/query",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "transactions", "query"]
            },
            "description": "Query entries by date range, category, party, or dimension filters."
          }
        },
        {
          "name": "Get a ledger transaction",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "transactions", "{{transactionId}}"]
            },
            "description": "Retrieve a single ledger transaction by id."
          }
        }
      ]
    },
    {
      "name": "Sources",
      "item": [
        {
          "name": "Sync source transactions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"external_id\": \"txn-123\",\n      \"date\": \"2026-06-01\",\n      \"description\": \"Cloud hosting\",\n      \"amount\": { \"amount\": 4200, \"currency_code\": \"USD\" }\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sources/transactions/sync",
              "host": ["{{baseUrl}}"],
              "path": ["sources", "transactions", "sync"]
            },
            "description": "Push raw transactions to the AGL for enrichment and categorization. Idempotent via external_id."
          }
        },
        {
          "name": "Sync source parties",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [ { \"external_id\": \"party-abc\" } ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sources/parties/sync",
              "host": ["{{baseUrl}}"],
              "path": ["sources", "parties", "sync"]
            },
            "description": "Sync raw party data into the AGL."
          }
        }
      ]
    },
    {
      "name": "Parties",
      "item": [
        {
          "name": "List parties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/parties",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "parties"]
            },
            "description": "List enriched parties (vendors, customers, other relationships)."
          }
        },
        {
          "name": "Get a party",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/parties/{{partyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "parties", "{{partyId}}"]
            },
            "description": "Retrieve a single party by id."
          }
        }
      ]
    },
