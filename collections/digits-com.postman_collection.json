            },
            "description": "Accounts receivable aging report."
          }
        },
        {
          "name": "Summarize ledger",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ledger/summarize",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "summarize"]
            },
            "description": "Aggregate and summarize ledger data across dimensions and periods."
          }
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "List connected sources",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/connections/sources",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "sources"]
            },
            "description": "List the connected data sources feeding the ledger."
          }
        },
        {
          "name": "Sync a connected source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/connections/sources/sync",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "sources", "sync"]
            },
            "description": "Trigger a sync of a connected data source."
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
